{
  "title": "OpenShell Gateway",
  "uid": "openshell-gateway",
  "description": "Request rates, errors, latency and database readiness for the OpenShell gateway, from the metrics the gateway itself exports.",
  "tags": [
    "openshell",
    "gateway"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Gateway up",
      "description": "1 when the last scrape of the gateway succeeded. A gap here means the collector could not reach the metrics port, not that the gateway is down.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheusds}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheusds}"
          },
          "expr": "up{juju_model=~\"$juju_model\",juju_model_uuid=~\"$juju_model_uuid\",juju_application=~\"$juju_application\",juju_unit=~\"$juju_unit\"}",
          "legendFormat": "{{juju_unit}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Database healthy",
      "description": "openshell_server_readiness_database_healthy: the gateway's own view of its PostgreSQL connection, 1 when the last probe succeeded.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheusds}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheusds}"
          },
          "expr": "openshell_server_readiness_database_healthy{juju_model=~\"$juju_model\",juju_model_uuid=~\"$juju_model_uuid\",juju_application=~\"$juju_application\",juju_unit=~\"$juju_unit\"}",
          "legendFormat": "{{juju_unit}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "gRPC request rate",
      "description": "Requests per second by method, from openshell_server_grpc_requests_total. The series appear only once the gateway has served a request: the metrics registry is populated lazily, so an idle gateway exports nothing.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheusds}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheusds}"
          },
          "expr": "sum by (method) (rate(openshell_server_grpc_requests_total{juju_model=~\"$juju_model\",juju_model_uuid=~\"$juju_model_uuid\",juju_application=~\"$juju_application\",juju_unit=~\"$juju_unit\"}[5m]))",
          "legendFormat": "{{method}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "gRPC error rate",
      "description": "Requests per second whose gRPC code is not OK. A sustained non-zero rate here is the first thing to look at when clients report failures.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheusds}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheusds}"
          },
          "expr": "sum by (code) (rate(openshell_server_grpc_requests_total{juju_model=~\"$juju_model\",juju_model_uuid=~\"$juju_model_uuid\",juju_application=~\"$juju_application\",juju_unit=~\"$juju_unit\",code!=\"OK\"}[5m]))",
          "legendFormat": "{{code}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "gRPC latency by method (p50/p90/p99)",
      "description": "openshell_server_grpc_request_duration_seconds. The workload exports this as a Prometheus summary with pre-computed quantile labels, not as a histogram, so the quantiles are read directly \u2014 there are no _bucket series and histogram_quantile() would return nothing.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheusds}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheusds}"
          },
          "expr": "openshell_server_grpc_request_duration_seconds{juju_model=~\"$juju_model\",juju_model_uuid=~\"$juju_model_uuid\",juju_application=~\"$juju_application\",juju_unit=~\"$juju_unit\",quantile=\"0.5\"}",
          "legendFormat": "{{method}} p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheusds}"
          },
          "expr": "openshell_server_grpc_request_duration_seconds{juju_model=~\"$juju_model\",juju_model_uuid=~\"$juju_model_uuid\",juju_application=~\"$juju_application\",juju_unit=~\"$juju_unit\",quantile=\"0.9\"}",
          "legendFormat": "{{method}} p90",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheusds}"
          },
          "expr": "openshell_server_grpc_request_duration_seconds{juju_model=~\"$juju_model\",juju_model_uuid=~\"$juju_model_uuid\",juju_application=~\"$juju_application\",juju_unit=~\"$juju_unit\",quantile=\"0.99\"}",
          "legendFormat": "{{method}} p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "HTTP request rate",
      "description": "The gateway's HTTP surface (health and metrics endpoints included), from openshell_server_http_requests_total.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheusds}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheusds}"
          },
          "expr": "sum by (path, status) (rate(openshell_server_http_requests_total{juju_model=~\"$juju_model\",juju_model_uuid=~\"$juju_model_uuid\",juju_application=~\"$juju_application\",juju_unit=~\"$juju_unit\"}[5m]))",
          "legendFormat": "{{path}} {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Database probe duration (p90)",
      "description": "How long the readiness probe's database check takes, split by outcome. A rising p90 precedes the healthy gauge flipping. Exported as a summary, so the quantile is read directly.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheusds}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheusds}"
          },
          "expr": "openshell_server_readiness_database_probe_duration_seconds{juju_model=~\"$juju_model\",juju_model_uuid=~\"$juju_model_uuid\",juju_application=~\"$juju_application\",juju_unit=~\"$juju_unit\",quantile=\"0.9\"}",
          "legendFormat": "{{outcome}} p90",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "juju_model",
        "label": "Juju model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheusds}"
        },
        "query": "label_values(up, juju_model)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "regex": "",
        "sort": 1,
        "options": [],
        "current": {}
      },
      {
        "name": "juju_model_uuid",
        "label": "Juju model uuid",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheusds}"
        },
        "query": "label_values(up, juju_model_uuid)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "regex": "",
        "sort": 1,
        "options": [],
        "current": {}
      },
      {
        "name": "juju_application",
        "label": "Juju application",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheusds}"
        },
        "query": "label_values(up, juju_application)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "regex": "",
        "sort": 1,
        "options": [],
        "current": {}
      },
      {
        "name": "juju_unit",
        "label": "Juju unit",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheusds}"
        },
        "query": "label_values(up, juju_unit)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "regex": "",
        "sort": 1,
        "options": [],
        "current": {}
      }
    ]
  }
}
